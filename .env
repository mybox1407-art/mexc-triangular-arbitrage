NODE_ENV=development
LOG_LEVEL=info

MEXC_REST_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs-api.mexc.com/ws

# Paper mode: реальные ордера не отправляются.
LIVE_TRADING=false

# Базовая валюта и размер виртуального цикла.
START_ASSET=USDC
START_NOTIONAL=100
MAX_NOTIONAL_PER_CYCLE=100

# Paper-arbitrage thresholds.
# Порог net ROI (можно использовать для анализа, но не как основной фильтр).
# 0.1% — более мягкий порог, чтобы видеть больше сигналов в бумажных логах.
MIN_NET_ROI=0.001

# Новый порог для gross ROI после комиссий (до safety buffer).
# 0.3% — целевой порог для сделок, которые ты реально будешь рассматривать как исполнимые.
MIN_GROSS_ROI_AFTER_FEES=0.003

# Standard MEXC spot taker fee: 0.05%.
# Укажи здесь свою фактическую ставку, если в аккаунте есть скидка.
# С MX токенами: 20% скидка = 0.04% (0.0004)
TAKER_FEE_RATE=0.0004

# Дополнительный резерв 0.02% на движение рынка и задержку.
SAFETY_BUFFER_RATE=0.0002

# CSV только для прошедших paper-сигналов.
CSV_OPPORTUNITIES_PATH=/app/data/paper-opportunities.csv

# CSV с лучшим маршрутом за каждый 10-секундный интервал.
CSV_BEST_ROUTES_PATH=/app/data/paper-best-routes.csv

# .env
PERFORMANCE_LOG_PATH=/app/logs/performance.log

# Оставь пустыми, пока LIVE_TRADING=false.
MEXC_API_KEY=mx0vgljV19sTyPcdD3
MEXC_API_SECRET=e118a8bca7404840901a87d3cfde7d99

DATABASE_URL=postgresql://arb:arb_password@db:5432/mexc_arb

TELEGRAM_BOT_TOKEN=8762948927:AAHK3XOBXJFO62i_ivKBf54PKbT_BUSQ5T4
