NODE_ENV=development
LOG_LEVEL=info

MEXC_REST_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs-api.mexc.com/ws

# На первом этапе false: только логирование возможностей.
LIVE_TRADING=false

# Стартовая валюта и лимиты
START_ASSET=USDT
START_NOTIONAL=25
MAX_NOTIONAL_PER_CYCLE=25
MIN_NET_ROI=0.0030
TAKER_FEE_RATE=0.0010
SAFETY_BUFFER_RATE=0.0005

# Для будущего live-режима
MEXC_API_KEY=
MEXC_API_SECRET=

DATABASE_URL=postgresql://arb:arb_password@db:5432/mexc_arb
