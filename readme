cd ~
rm -rf mexc-triangular-arbitrage
git clone https://github.com/mybox1407-art/mexc-triangular-arbitrage.git
cd mexc-triangular-arbitrage
npm install protobufjs
npm install -D @types/protobufjs
docker compose up -d --build
npm install

docker compose logs -f arbitrage-bot


